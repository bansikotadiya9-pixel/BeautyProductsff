<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Comp_Activity6">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:layout_marginTop="12dp"
        android:elevation="0dp"
        android:padding="8dp"
        app:cardCornerRadius="5dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:id="@+id/Com4"
            android:src="@drawable/c4" />
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comoact Powder"
            android:layout_marginTop="25dp"
            android:textStyle="bold"
            android:textSize="30dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Oli Control and Shine,Set foundation,Touch-Ups,Base Layer,
            Makeup Fixer,Moisturize,Offering a Smoother,Face powders"
            android:layout_marginTop="10dp"
            android:textSize="20dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="₹800"
            android:layout_marginTop="10dp"
            android:textSize="35dp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  #BESTSELLER  "
            android:background="@drawable/shape_1"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="30dp"
            android:layout_marginTop="10dp"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buy Now"
            android:layout_marginTop="5dp"
            android:textStyle="bold"
            android:textSize="30dp"
            android:layout_marginRight="16dp"
            android:id="@+id/com4"/>
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continue Shoping"
            android:layout_marginTop="5dp"
            android:textStyle="bold"
            android:textSize="30dp"
            android:layout_marginRight="16dp"
            android:id="@+id/Add"/>


    </LinearLayout>

</LinearLayout>